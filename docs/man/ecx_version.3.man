.TH ecx_version 3 "@DATE@" "@VERSION@" "Library calls"

.SH NAME
\"{{{
version \- function
\"}}}

.SH LIBRARY
\"{{{
Codata library 
.RI ( libecx ", " \-lecx )
\"}}}

.SH SYNOPSIS
\"{{{ 
.IP Fortran 10
.BI "function version()result(" fptr ")"
.RS
.IP "" 3
.BI "character(len=:), pointer :: " fptr 
.RE

.IP C 10
.B char* ecx_version()

.IP Python 10
.BI str: ecx.__version__
\"}}}

.SH DESCRIPTION
\"{{{
Get the library version.
\"}}}

.SH RETURN VALUE
\"{{{
.IP pointer 10 
Pointer to the version string.
\"}}}

.SH EXAMPLE
\"{{{
.PP
Fortran:
.nf
.ft CR
    use ecx
    print *, "version = ", version()
.ft R
.fi

.PP
C:
.nf
.ft CR
    include <stdio.h>
    include "ecx.h"
    printf("version = %s\\n", ecx_version());
.ft R
.fi

.PP
Python:
.nf
.ft CR
    import pyecx
    print(f"version = {pyecx.__version__}")
.ft R
.fi
\"}}}

